<Application x:Class="AURA.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
            <SolidColorBrush x:Key="SecondPanelBrush" Color="#1F2937" />
            <SolidColorBrush x:Key="BorderBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#8B5CF6" />
            <SolidColorBrush x:Key="AccentBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
            <Style TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#8B5CF6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
